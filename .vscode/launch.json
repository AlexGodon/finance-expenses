{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run main.py (accumulate)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--month", "2026-03", "--file", "financial_report.xlsx"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "justMyCode": false,
        },
        {
            "name": "Run main.py (new file)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            // "args": ["--month", "2026-01", "--timestamp"],
            "args": ["--month", "2026-01", "--fresh-file"],
            // "args": ["--month", "2026-01"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "justMyCode": false,
        },
        {
            "name": "Run smith_manoeuvre.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/smith_manoeuvre.py",
            "args": [
                "--initial-amount", "470000.00",
                "--amortization", "20",
                "--mortgage-rate", "5.40",
                "--heloc-rate", "7.00",
                "--tax-bracket", "20.00",
                "--rental-income", "2100.00",
                "--frequency", "monthly",
                "--output", "smith_manoeuvre_7_percent.xlsx"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "internalConsole",
            "justMyCode": false,
        }
    ]
}
